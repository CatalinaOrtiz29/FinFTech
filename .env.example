# ===== FinFTech - Variables de entorno de ejemplo =====
# Copia este archivo a .env y ajusta los valores. NO versiones el .env real.

# --- API ---
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
APP_COMMIT=unknown
# OrÃƒÂ­genes permitidos por CORS (separados por coma)
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# --- Persistencia ---
DB_PATH=/data/finftech.db
DEFAULT_CURRENCY=USD

# --- AutenticaciÃƒÂ³n ---
# Cambia este secreto. Se usa para firmar los tokens.
TOKEN_SECRET=change-me-please
TOKEN_TTL_SECONDS=28800
ADMIN_EMAIL=admin@finftech.local
ADMIN_PASSWORD=finftech-admin
ADMIN_NAME=FinFTech Admin

# --- Ejecutor de pruebas interno ---
RUNNER_MAX_VUS=100
RUNNER_MAX_DURATION_MS=60000
RUNNER_REQUEST_TIMEOUT_MS=5000

# --- Frontend ---
# URL pÃƒÂºblica de la API consumida por el navegador
VITE_API_BASE_URL=http://localhost:3000

# --- k6 ---
K6_BASE_URL=http://api:3000
K6_TOKEN=
K6_VUS=10
K6_DURATION=15s
K6_P95_MS=800
K6_ERROR_RATE=0.01
